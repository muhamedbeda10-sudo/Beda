# ---------------------------------------------------------------------------
# QC System — API configuration.
#
# Copy to `server/.env` for local development. On Azure App Service every one
# of these is an Application Setting (Configuration → Application settings);
# never commit a real value.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Azure Database for PostgreSQL requires TLS:
#   postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/qc?sslmode=require
DATABASE_URL=postgresql://qc:qc@127.0.0.1:5432/qc_dev

# Secret used to sign access tokens. At least 32 random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-before-going-live

# Lifetimes. Access tokens are short and live in memory; refresh tokens are
# httpOnly cookies backed by a revocable row in auth_sessions.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Where inspection photos are stored.
#   local       server/data/images on the App Service disk (dev only — not durable)
#   azure-blob  Azure Blob Storage (production)
IMAGE_STORAGE_DRIVER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=qc-images

# Whether new people may create their own account from the login screen.
# The very first account is always allowed and becomes the admin. After that,
# set this to false and let an admin create accounts from Admin → Users.
AUTH_ALLOW_SELF_REGISTRATION=true

# Apply pending database migrations when the API starts (recommended on Azure,
# so a deploy and its schema change ship together).
RUN_MIGRATIONS_ON_START=true

# Seed demo master data (machines, defects, dimension configuration, sample
# orders) into an EMPTY database when the first admin signs in. Turn off for a
# clean production database.
SEED_DEMO_DATA=false

# HTTP port. Azure App Service sets PORT itself; leave unset there.
PORT=8080

# Set to true behind Azure's load balancer so secure cookies and client IPs
# are read from X-Forwarded-* headers.
TRUST_PROXY=false
