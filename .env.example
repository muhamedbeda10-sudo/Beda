# ---------------------------------------------------------------------------
# Firebase configuration.
# Copy this file to `.env` (or `.env.local`) and fill in the values from your
# Firebase project:  Project settings → General → Your apps → SDK setup (Config).
#
# If these are left blank / the file is absent, the app automatically runs in
# LOCAL DEMO MODE (data stored in the browser, no login required).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional flags -------------------------------------------------------------
# Free (Spark) plan has no Cloud Storage. Set to false to store inspection
# images as compressed base64 inside Firestore instead (no billing needed).
# Leave unset / true only if you upgraded to Blaze and enabled Storage.
VITE_FIREBASE_USE_STORAGE=false

# Set to false to start with a completely empty database (no demo seed data).
# VITE_FIREBASE_SEED=false
