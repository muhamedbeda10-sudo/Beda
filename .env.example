# ---------------------------------------------------------------------------
# Firebase configuration.
# Copy this file to `.env` (or `.env.local`) and fill in the values from your
# Firebase project:  Project settings → General → Your apps → SDK setup (Config).
#
# If these are left blank / the file is absent, the app automatically runs in
# LOCAL DEMO MODE (data stored in the browser, no login required).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
